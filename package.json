{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@devlsh/astar",
  "version": "5.0.0",
  "description": "A* pathfinding for 2D grids with elevation support.",
  "keywords": [
    "2d",
    "a-star",
    "astar",
    "elevation",
    "grid",
    "pathfinding",
    "typescript"
  ],
  "homepage": "https://github.com/devlsh/astar#readme",
  "bugs": {
    "url": "https://github.com/devlsh/astar/issues"
  },
  "license": "MIT",
  "author": {
    "name": "devlsh",
    "email": "contact@devlsh.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devlsh/astar.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/devlsh"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "bench:full": "vitest bench --run --config bench.config.ts --project 'full (bench)'",
    "bench:quick": "vitest bench --run --config bench.config.ts --project 'quick (bench)'",
    "build": "tsdown",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check",
    "demo": "pnpm --filter @devlsh/astar-demo",
    "fix:all": "pnpm lint:fix && pnpm fmt",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --deny-warnings --fix",
    "prepack": "pnpm build",
    "prepare": "lefthook install --force",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@devlsh/tools": "1.0.1",
    "@oxlint/plugins": "1.86.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tsconfig/node24": "24.0.5",
    "@types/node": "24.19.0",
    "lefthook": "2.1.14",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.27.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "error"
    }
  }
}
